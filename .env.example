# Copy to .env or export in your shell environment
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_FAST_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30s
OLLAMA_SANDBOX_ROOT=.

# For the standalone Telegram bot (glama-bot)
TELEGRAM_BOT_TOKEN=<your-botfather-token>
TELEGRAM_ALLOWED_USER_IDS=<your-numeric-telegram-user-id>
