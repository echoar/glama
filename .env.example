# Copy to .env or ~/.config/glama/config.json
OLLAMA_HOST=http://127.0.0.1:11434

# Model role mapping (automatically verified against installed 'ollama list' models)
OLLAMA_DEFAULT_MODEL=qwen3:8b
OLLAMA_TOOL_MODEL=qwen3:8b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_FAST_MODEL=qwen2.5:3b

# Ordered OOM auto-downgrade ladder (comma-separated)
GLAMA_FALLBACK_LADDER=qwen3:8b,qwen2.5-coder:7b,qwen2.5:3b

# Hardware & memory tuning
GLAMA_NUM_CTX=4096
GLAMA_RESERVE_MEM_MB=500
OLLAMA_KEEP_ALIVE=30s
OLLAMA_SANDBOX_ROOT=.

# For the standalone Telegram bot (glama-bot)
TELEGRAM_BOT_TOKEN=<your-…ken>
TELEGRAM_ALLOWED_USER_IDS=<your-numeric-telegram-user-id>

# Security & Sandbox Mode (Host-only setting; never mutable from chat)
# Options: readonly (default) | workspace-write (allows .md/.txt/.json/.csv writes inside OLLAMA_SANDBOX_ROOT)
GLAMA_PERMISSION_MODE=readonly
